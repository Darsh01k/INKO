# Inko Platform — environment template. Copy to .env (never commit .env)

# --- Database (local portable PostgreSQL) ---
INKO_DB_URL=jdbc:postgresql://localhost:5432/inko
INKO_DB_USER=inko_app
INKO_DB_PASSWORD=inko_app_dev_pwd

# --- Backend ---
SERVER_PORT=8080
# Generate a real 256-bit secret for anything beyond local dev:
INKO_JWT_SECRET=dev-only-secret-change-me-in-production-0123456789abcdef
INKO_STORAGE_ROOT=./data/storage

# --- Payment provider: 'mock' only for now (see DEFERRED.md) ---
PAYMENT_PROVIDER=mock

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
